pragma language_version >= 0.23;

import CompactStandardLibrary;

export struct Event {
  name: Opaque<"string">,
  date: Uint<64>,
  threshold: Uint<64>,
  organizer: Bytes<32>,
}

export ledger events: Map<Bytes<32>, Event>;
export ledger attendance: Map<Bytes<32>, Set<Bytes<32>>>;
export ledger certificates: Set<Bytes<32>>;
export ledger sequence: Counter;

witness identitySecret(): Bytes<32>;

circuit organizerIdentity(): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "ppai:organizer:"), sequence as Field as Bytes<32>, identitySecret()]
  );
}

circuit attendeeIdentity(eventId: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "ppai:attendee:"), eventId, identitySecret()]
  );
}

circuit certificateId(eventId: Bytes<32>, identity: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "ppai:cert:"), eventId, identity]
  );
}

export pure circuit computeAttendeeIdentity(eventId: Bytes<32>, secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "ppai:attendee:"), eventId, secret]
  );
}

constructor() {}

export circuit createEvent(eventId: Bytes<32>, name: Opaque<"string">, date: Uint<64>, threshold: Uint<64>): [] {
  assert(!events.member(disclose(eventId)), "An event with this ID already exists");
  events.insert(disclose(eventId), disclose(Event {
    name: name,
    date: date,
    threshold: threshold,
    organizer: organizerIdentity(),
  }));
  attendance.insert(disclose(eventId), default<Set<Bytes<32>>>);
  sequence.increment(1);
}

export circuit checkIn(eventId: Bytes<32>): [] {
  assert(events.member(disclose(eventId)), "This event does not exist");
  const identity = attendeeIdentity(eventId);
  assert(!attendance.lookup(disclose(eventId)).member(disclose(identity)), "Already checked in to this event");
  attendance.lookup(disclose(eventId)).insert(disclose(identity));
}

export circuit issueCertificate(eventId: Bytes<32>): Bytes<32> {
  assert(events.member(disclose(eventId)), "This event does not exist");
  const event = events.lookup(disclose(eventId));
  const identity = attendeeIdentity(eventId);
  assert(attendance.lookup(disclose(eventId)).member(disclose(identity)), "You have not checked in to this event");
  assert(attendance.lookup(disclose(eventId)).size() >= event.threshold, "Attendance threshold not met");
  const certId = certificateId(eventId, identity);
  assert(!certificates.member(disclose(certId)), "Certificate already issued");
  certificates.insert(disclose(certId));
  return disclose(certId);
}
